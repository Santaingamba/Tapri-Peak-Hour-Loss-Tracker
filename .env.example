# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
TAPRI_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
TAPRI_ADMIN_PIN=replace-with-a-private-password-of-at-least-8-characters
TAPRI_HTTPS=0
# Optional: TAPRI_DB_PATH=/absolute/path/to/tapri.sqlite3
# Optional: TAPRI_TIMEZONE=Asia/Kolkata
# Optional: TAPRI_HOST=127.0.0.1
# Optional: PORT=5000
